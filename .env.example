# --- Database ---------------------------------------------------------------
# Local (pnpm dev on the host, Postgres from docker compose on port 5432)
DATABASE_URL=postgres://fitapp:fitapp@localhost:5432/fitapp

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Set to false after you've created your own account to close registration.
ALLOW_SIGNUP=true

# --- App defaults -----------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Stockholm

# --- AI (Phase 2: food photo analysis). Server-side only, never NEXT_PUBLIC_ ---
ANTHROPIC_API_KEY=
# Vision-capable model used to estimate meals from photos.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage (Phase 2: food photos) -----------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/uploads
# Required only when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# --- Docker ------------------------------------------------------------------
# Host port for the app container (default 3001; 3000 is often taken by other tools).
APP_PORT=3001
