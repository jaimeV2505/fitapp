{
  "name": "fitapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "media:sync": "tsx scripts/sync-exercise-media.ts",
    "media:library": "tsx scripts/import-exercise-library.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:backup": "sh scripts/backup-db.sh",
    "db:restore": "sh scripts/restore-db.sh",
    "db:verify-backup": "sh scripts/verify-backup.sh",
    "e2e:install": "playwright install chromium",
    "test:e2e:docker": "docker compose --profile e2e run --rm e2e",
    "db:clean-e2e": "sh scripts/clean-e2e-users.sh",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate:ci": "tsx scripts/db-migrate.ts",
    "check:migrations": "sh scripts/check-migrations.sh",
    "model:check": "tsx scripts/check-anatomy-model.ts",
    "check:data": "sh scripts/check-data-files.sh",
    "ai:check": "tsx scripts/check-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@gsap/react": "^2.1.2",
    "@number-flow/react": "^0.5.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-three/fiber": "^9.0.0",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.3.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.540.0",
    "motion": "^12.23.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.170.0",
    "vaul": "^1.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.170.0",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
